        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class User {\n        &lt;&lt;abstract&gt;&gt;\n        -Guid id\n        -string fullName\n        -string email\n        #string passwordHash\n        +Login(password) bool\n    }\n    class Client {\n        -string qrToken\n        +Book(session) Booking\n        +Cancel(bookingId) void\n        +Buy(plan) Membership\n    }\n    class Trainer {\n        -string specialization\n        +GetSchedule(date) List~ClassSession~\n        +MarkAttendance(bookingId) void\n    }\n    class Administrator {\n        +SellMembership(client, plan) Membership\n        +FindClient(query) List~Client~\n    }\n    class MembershipPlan {\n        -string name\n        -PlanKind kind\n        -int visitsCount\n        -int days\n        -decimal price\n    }\n    class Membership {\n        -MembershipStatus status\n        -DateTime startDate\n        -DateTime endDate\n        -int visitsLeft\n        +Activate() void\n        +Freeze(days) void\n        +Unfreeze() void\n        +Consume() void\n        +IsValid() bool\n    }\n    class Payment {\n        -decimal amount\n        -PaymentStatus status\n        -string externalId\n        +MarkPaid() void\n    }\n    class ClassType {\n        -string name\n    }\n    class Hall {\n        -string name\n        -int capacity\n    }\n    class ClassSession {\n        -DateTime startAt\n        -DateTime endAt\n        -int capacity\n        +FreePlaces() int\n    }\n    class Booking {\n        -BookingStatus status\n        -DateTime createdAt\n        +Cancel() void\n        +MarkVisited() void\n    }\n    class Visit {\n        -DateTime checkedInAt\n    }\n    class IPaymentGateway {\n        &lt;&lt;interface&gt;&gt;\n        +CreatePayment(amount) string\n        +CheckStatus(externalId) PaymentStatus\n    }\n    class OnlineGateway {\n        +CreatePayment(amount) string\n        +CheckStatus(externalId) PaymentStatus\n    }\n    class CashDesk {\n        +CreatePayment(amount) string\n        +CheckStatus(externalId) PaymentStatus\n    }\n    class INotifier {\n        &lt;&lt;interface&gt;&gt;\n        +Send(recipient, message) void\n    }\n    class EmailNotifier {\n        +Send(recipient, message) void\n    }\n    class SmsNotifier {\n        +Send(recipient, message) void\n    }\n    class BookingService {\n        -INotifier notifier\n        +Book(client, session) Booking\n        +Cancel(bookingId) void\n    }\n    class AccessService {\n        +CheckQr(token) AccessResult\n    }\n    User &lt;|-- Client\n    User &lt;|-- Trainer\n    User &lt;|-- Administrator\n    IPaymentGateway &lt;|.. OnlineGateway\n    IPaymentGateway &lt;|.. CashDesk\n    INotifier &lt;|.. EmailNotifier\n    INotifier &lt;|.. SmsNotifier\n    MembershipPlan \&quot;1\&quot; --&gt; \&quot;*\&quot; Membership\n    Client \&quot;1\&quot; --&gt; \&quot;*\&quot; Membership\n    Membership \&quot;1\&quot; --&gt; \&quot;*\&quot; Payment\n    ClassType \&quot;1\&quot; --&gt; \&quot;*\&quot; ClassSession\n    Trainer \&quot;1\&quot; --&gt; \&quot;*\&quot; ClassSession\n    Hall \&quot;1\&quot; --&gt; \&quot;*\&quot; ClassSession\n    ClassSession \&quot;1\&quot; *-- \&quot;*\&quot; Booking\n    Client \&quot;1\&quot; --&gt; \&quot;*\&quot; Booking\n    Booking \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Visit\n    Membership \&quot;1\&quot; --&gt; \&quot;*\&quot; Visit\n    BookingService ..&gt; Booking\n    BookingService ..&gt; INotifier\n    AccessService ..&gt; Membership\n    Payment ..&gt; IPaymentGateway&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="143">
